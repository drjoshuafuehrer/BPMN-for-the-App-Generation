                    <triso:itemComponent id="_8cf5ab9b-e2eb-4a11-93ba-b430155e2190" name="language" isCollection="false" triso:isProtected="false">
                        <triso:description>&lt;p&gt;Language code for the language the input text is written in (eg: en, fr).&lt;/p&gt;</triso:description>
                        <triso:typeRef>string</triso:typeRef>
                    </triso:itemComponent>
                    <triso:itemComponent id="_e81132ae-9930-4152-a4a2-13c8416e4592" name="settings" isCollection="false" triso:isProtected="false">
                        <triso:description>&lt;p&gt;A dictionnary or a json object to specify specific models to use for some providers. &lt;br&gt;                     It can be in the following format: {'google' : 'google&lt;em&gt;model', ibm': 'ibm&lt;/em&gt;model'…}.
                     &lt;strong&gt;Caution&lt;/strong&gt;: setting models can be done only with &lt;code&gt;Content-Type&lt;/code&gt; : &lt;code&gt;application/json&lt;/code&gt;.&lt;/p&gt;</triso:description>
                        <triso:typeRef>Any</triso:typeRef>
                    </triso:itemComponent>
                    <triso:itemComponent id="_ccb668f4-3557-474d-9316-dca3bb2a50e4" name="output_sentences" isCollection="false" triso:isProtected="false">
                        <triso:typeRef>number</triso:typeRef>
                        <triso:allowedValues>
                            <semantic:extensionElements>
                                <triso:constraintDetails id="_2c25e258-9df9-4f0d-8909-666a38ef230e" constraintsType="simple" min="1" minIncluded="true">
                                    <triso:value>&gt;=1</triso:value>
                                    <triso:display>&gt;=1</triso:display>
                                </triso:constraintDetails>
                            </semantic:extensionElements>
                            <triso:text>&gt;=1</triso:text>
                        </triso:allowedValues>
                    </triso:itemComponent>
                </triso:itemDefinition>
