                                </triso:constraintDetails>
                            </semantic:extensionElements>
                            <triso:text>not(? = null)</triso:text>
                        </triso:allowedValues>
                    </triso:itemComponent>
                    <triso:itemComponent id="_49f5746f-28be-42e3-b378-c4d8b49cc387" name="show_original_response" isCollection="false" triso:isProtected="false">
