                        </triso:allowedValues>
                    </triso:itemComponent>
                    <triso:itemComponent id="_fbd9ad8d-fdf6-4952-8eaa-b4680653b91c" name="users_webhook_parameters" isCollection="false" triso:isProtected="false">
                        <triso:description>&lt;p&gt;Json data that contains of additional parameters that will be sent back to the webhook receiver             (ex: api key for security or client's data ID to link the result internally).             Will only be used when webhook_receiver is set.&lt;/p&gt;</triso:description>
                        <triso:typeRef>Any</triso:typeRef>
                        <triso:allowedValues>
                            <semantic:extensionElements>
                                <triso:constraintDetails id="_b1d9a764-ed36-4139-82ca-89f68cc82f97" constraintsType="notNull">
                                    <triso:value>not(? = null)</triso:value>
                                    <triso:display>not(null)</triso:display>
                                </triso:constraintDetails>
                            </semantic:extensionElements>
                            <triso:text>not(? = null)</triso:text>
                        </triso:allowedValues>
