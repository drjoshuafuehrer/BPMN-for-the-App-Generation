                                    <triso:value>[0..1]</triso:value>
                                    <triso:display>[0..1]</triso:display>
                                </triso:constraintDetails>
                            </semantic:extensionElements>
                            <triso:text>[0..1]</triso:text>
                        </triso:allowedValues>
                    </triso:itemComponent>
                </triso:itemDefinition>
