                                    <triso:display>not(null)</triso:display>
                                </triso:constraintDetails>
                            </semantic:extensionElements>
                            <triso:text>not(? = null)</triso:text>
                        </triso:allowedValues>
                    </triso:itemComponent>
                    <triso:itemComponent id="_2fbca202-4f95-4191-8834-9a247ae033da" name="score" isCollection="false" triso:isProtected="false">
                        <triso:typeRef>number</triso:typeRef>
