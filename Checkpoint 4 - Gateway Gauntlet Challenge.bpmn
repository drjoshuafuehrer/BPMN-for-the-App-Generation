    <semantic:process id="_838e45ba-eb20-46fa-b5d2-e4d75464cc07" name="advanced" triso:readOnly="false" triso:collectEnds="true" isClosed="false">
        <semantic:textAnnotation id="_4844db0e-88c5-4a0c-83a8-9a9c771be57b">
            <semantic:text>A Parallel Gateway join waits for all parallel paths to finish.] In a mobile game IAP, after payment approval you might run tasks in parallel: “Grant gems,” “Update receipts,” and “Log analytics.” The Parallel join downstream holds the flow until every parallel task completes, then continues to “Notify player: purchase complete.</semantic:text>
        </semantic:textAnnotation>
    </semantic:process>
