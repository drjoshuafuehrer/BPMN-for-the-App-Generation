        <semantic:textAnnotation id="_02be5fee-d408-4ec6-bbee-00f95fdb11b2">
            <semantic:text>IAP = in app purchase</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_b4e88325-1cda-4428-a623-d2facd5ca50d">
            <semantic:text>Calls fraud detection APIs (e.g., Sift, Forter, or in-house ML models) to identify suspicious behavior.</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_0d307e1c-cc82-4daf-afc7-11bb32ea5664">
            <semantic:text>If verification fails, a Throw Compensation Event triggers rollback actions like “Revoke Gems”</semantic:text>
        </semantic:textAnnotation>
