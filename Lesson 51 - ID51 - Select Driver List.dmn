        <semantic:decisionTable triso:descriptionVisible="false" id="_63e0ff29-6fec-49f0-9fe7-5acf39137d00" hitPolicy="COLLECT" outputLabel="Select Driver" typeRef="string" triso:expressionId="_bd49ce8b-0762-4677-a3de-52046c90893a">
            <semantic:input id="_50ea5a69-4827-49e9-b469-cfa6c2eea871" label="Evaluate Rating">
                <semantic:inputExpression typeRef="string">
                    <semantic:text>Evaluate Rating</semantic:text>
                </semantic:inputExpression>
                <semantic:inputValues triso:constraintsType="expression">
                    <semantic:text>"driverRating": "driver.rating"</semantic:text>
                </semantic:inputValues>
            </semantic:input>
            <semantic:input id="_4c803cd3-be4c-45ca-be0e-af136cbd0c4a" label="Evaluate Proximity">
                <semantic:inputExpression typeRef="string">
                    <semantic:text>Evaluate Proximity</semantic:text>
                </semantic:inputExpression>
                <semantic:inputValues triso:constraintsType="expression">
                    <semantic:text>"driverProximity": "distanceBetween"("driver.location", "request.pickup")</semantic:text>
                </semantic:inputValues>
            </semantic:input>
            <semantic:input id="_9387cd88-b8cd-4169-a234-2c4397cc3119" label="Vehicle Type">
                <semantic:inputExpression typeRef="string">
                    <semantic:text>Vehicle Type</semantic:text>
                </semantic:inputExpression>
                <semantic:inputValues triso:constraintsType="expression">
                    <semantic:text>"vehicleType": "driver.vehicleType"</semantic:text>
                </semantic:inputValues>
            </semantic:input>
            <semantic:input id="_c29546ed-f12c-4f49-92b2-54b99601d0c8" label="Surge Zone">
                <semantic:inputExpression typeRef="string">
                    <semantic:text>Surge Zone</semantic:text>
                </semantic:inputExpression>
                <semantic:inputValues triso:constraintsType="expression">
                    <semantic:text>"surgeZone": "request.surgeZone"</semantic:text>
                </semantic:inputValues>
            </semantic:input>
            <semantic:output id="_fd327dd1-733b-4873-8627-255e87065519" triso:allowNull="true" typeRef="string">
                <semantic:outputValues triso:constraintsType="expression">
                    <semantic:text>"eligibleDrivers" = for d in "DriverList" 
"where" (d."proximity" &lt;= 5 and d."rating" &gt;= 4.5) 
return d."id",null</semantic:text>
                </semantic:outputValues>
                <semantic:defaultOutputEntry>
                    <semantic:text>list</semantic:text>
                </semantic:defaultOutputEntry>
            </semantic:output>
            <semantic:annotation name="Description"/>
            <semantic:rule id="_dbce80f6-9307-4bce-ac04-3961dce5ecbb">
                <semantic:inputEntry id="_46c225f8-fe7d-4219-9604-c56fd2e51be8">
                    <semantic:text>"≥ 4.8"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_7b109f8d-00aa-4718-a8cf-5d386157e01d">
                    <semantic:text>"≤ 3"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_c08e3a3d-b24d-418b-8d65-91ebde9fd0d0">
                    <semantic:text>= "Request Type"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_10f83422-3f6c-4dfe-b5f7-3585afe14006">
                    <semantic:text>true</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_797e064f-7943-4561-8ccd-7cabefc36b1f">
                    <semantic:text>"Include" in "list"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_9e74df1a-dad2-4dd8-8dd9-6509a966934d">
                <semantic:inputEntry id="_41f6cec3-bf38-4f59-8ccc-5c2026fc20b1">
                    <semantic:text>"≥ 4.5"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_bb80cbf6-689e-4431-9235-be157250df76">
                    <semantic:text>"≤ 5"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_7bcae347-80e6-4996-8f88-09ef8ddc3189">
                    <semantic:text>= "Request Type"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_f708647c-e8cc-48c7-af84-86ef184c7f4d">
                    <semantic:text>false</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_8ddb69cf-b3d9-4473-bddb-a740e9cc0a54">
                    <semantic:text>"Include" in "list"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_ec083132-6b3a-48a7-8871-114e73716916">
                <semantic:inputEntry id="_7670528c-1993-4f69-8ebf-4f7dfe9684d3">
                    <semantic:text>"≥ 4.2"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_ff703c7b-3ffe-4959-9bbc-4d4f0fbc0e0d">
                    <semantic:text>"≤ 8"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_70eef40c-4f80-4291-b053-95883b372dd4">
                    <semantic:text>= "Request Type"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_45b971b1-511f-4b32-913d-341500102b64">
                    <semantic:text>false</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_d812f262-f2b4-44d2-830c-6f8ed7621a40">
                    <semantic:text>"Include" if "no closer driver"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_608ead09-e286-459e-a3d0-a90c9e401cb5">
                <semantic:inputEntry id="_9f35ad76-b0f8-489c-b532-cac261e1988b">
                    <semantic:text>"≥ 4.2"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_d3ba8dd9-bba3-4ddd-b35a-6b460662e407">
                    <semantic:text>&gt; 8</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_75c7fbd0-6811-4b68-adfa-966c29b000c8">
                    <semantic:text>= "Request Type"</semantic:text>
                </semantic:inputEntry>
                <semantic:inputEntry id="_0557d505-0e22-4161-833b-c4e7f09291c8">
                    <semantic:text>false</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_4a957626-59f4-46d7-8b57-d3a3d51128c4">
                    <semantic:text>"Exclude"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
        </semantic:decisionTable>
    </semantic:decision>
