    <semantic:process id="_c48801f5-443e-4f38-9796-16ade5ed9d26" name="Page 1" triso:readOnly="false" triso:collectEnds="true" isClosed="false">
        <semantic:textAnnotation id="_3d8787fa-8d4c-4b0e-b3f9-ee81aaedc408">
            <semantic:text>status examples: sold, payment failed, or non-response</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_6665061e-a56d-491d-b37d-94b70d2d15f7">
            <semantic:text>Waitlist Management Applications include: Ticketmaster Verified Fan Waitlist, AXS Waiting Room, Queue-It, Dice.fm</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_f7f73593-8cc6-41bb-9bee-ec6bbc03416e">
            <semantic:text>Ticketing Applications examples include: Ticketmaster/Live Nation, AXS, SeatGeek</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_b86c844b-273e-4327-88bc-0c0aa1bb92aa">
            <semantic:text>Note: Application users in many of these examples listed (e.g., Eventbrite) will have a seamless experience. This model uses two pools to hide process details of the ticketing application</semantic:text>
        </semantic:textAnnotation>
    </semantic:process>
