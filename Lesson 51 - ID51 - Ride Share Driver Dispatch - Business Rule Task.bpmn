    <semantic:process id="_c26bb01a-4301-461b-8236-3a8cf391776e" name="Page 1" triso:readOnly="false" triso:collectEnds="true" isClosed="false">
        <semantic:textAnnotation id="_b13a4aaf-8c7c-4d9f-978a-8eb98ddcb4ab">
            <semantic:text>Calls decision table evaluating driver proximity, rating, car type, and surge status.</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_4557b09a-5a55-4508-a232-cdce4bdc5fb1">
            <semantic:text>Show how the token flows from the process into a DMN decision service, and then returns a result.
Emphasize that the decision logic lives outside BPMN—in a DMN table (e.g., proximity &lt; 5 miles, rating ≥ 4.5, same car type).
Students can visualize how BPMN handles flow, while DMN handles logic.</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_82d38419-cc6c-4b25-a1f7-7d54f99f7b4d" triso:stencilId="Image" triso:bgimage="data:image/png;base64,">
            <semantic:text>Image</semantic:text>
        </semantic:textAnnotation>
    </semantic:process>
