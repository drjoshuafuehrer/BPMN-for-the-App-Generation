        <semantic:scriptTask id="_95c6a0b2-2dd0-45bf-b4a7-c20ec869d067" name="Calculate Cart Total" triso:readOnly="false" scriptFormat="text/x-script.python">
            <semantic:incoming>_b87ccd85-d684-41d7-a289-d169c71c6108</semantic:incoming>
            <semantic:outgoing>_e5c474ef-03e3-4e79-a5fe-983ee2a5431f</semantic:outgoing>
            <semantic:script>total = sum(item["price"] * item["qty"] for item in items) - discount + shipping + tax</semantic:script>
        </semantic:scriptTask>
