    <semantic:process id="_b0180812-352f-4874-b285-f6cfabb10b82" name="Page 1" triso:readOnly="false" triso:collectEnds="true" isClosed="false">
        <semantic:textAnnotation id="_a801100d-3fa0-4b3f-b865-ed56ae5a937f">
            <semantic:text>Demonstrates multi-pool messaging and handshakes between systems.

Encourages thinking in terms of service boundaries, not internal control.

Excellent for teaching message start/end events, send/receive tasks, and clear process ownership.</semantic:text>
        </semantic:textAnnotation>
    </semantic:process>
