    <semantic:process id="_707a4b2b-1daf-42d6-bc5e-3c48443c0be6" name="used in book" triso:readOnly="false" triso:collectEnds="true" isClosed="false">
        <semantic:textAnnotation id="_1e7eda66-cb8f-482b-9612-28ba333c0bd3">
            <semantic:text>Optional depiction of process collaboration and the details within another pool.</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_1294bb94-1be7-4883-b24a-b00d9605a223">
            <semantic:text>LLM Prompt Router examples: Anthropic’s Prompt Orchestrator, OpenAI Router, custom API gateway</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_a9ba00dd-731c-4f79-b4f4-2e15aa587fd8">
            <semantic:text>Knowledge base (KB) examples: SharePoint, Confluence, Salesforce, Hubspot, Workday, GitHub Wiki, Jira, Snowflake, Redshift, BigQuery, Wikidata, IEEE Xplore, etc., (too many to list)</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_d41cc20d-a48c-4c32-896f-6eef50e737bd">
            <semantic:text>Summarization service (Ss) examples: OpenAI Gpt-4 Turbo, Anthropic Claude, Cohere Summarize API, or fine-tuned BART models</semantic:text>
        </semantic:textAnnotation>
    </semantic:process>
