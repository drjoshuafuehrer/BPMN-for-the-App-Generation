    <semantic:process id="_cb420393-0d42-49ca-915c-207c87223115" name="larger LLM model" triso:readOnly="false" triso:collectEnds="true" isClosed="false">
        <semantic:textAnnotation id="_3c8d306f-dbcf-41ab-a2ba-9697156a691a">
            <semantic:text>Translation service (Ts) examples: Google cloud translation, Microsoft translator, DeepL translator, MarianMT</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_bee94e63-f79e-4a20-a93b-93124ad8ff5e">
            <semantic:text>Optional depiction of process collaboration and the details within another pool.</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_9c0336d9-13a9-4e16-8494-df5252934fff">
            <semantic:text>LLM Prompt Router examples: Anthropic’s Prompt Orchestrator, OpenAI Router, custom API gateway</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_b5077964-32b3-4cf6-8afc-e2eb6f8bd872">
            <semantic:text>Knowledge base examples: SharePoint, Confluence, Salesforce, Hubspot, Workday, GitHub Wiki, Jira, Snowflake, Redshift, BigQuery, Wikidata, IEEE Xplore, etc., (too many to list)</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_fd751e5c-ddc6-4466-b09e-d0e6840b9a11">
            <semantic:text>Summarization service (Ss) examples: OpenAI Gpt-4 Turbo, Anthropic Claude, Cohere Summarize API, or fine-tuned BART models</semantic:text>
        </semantic:textAnnotation>
    </semantic:process>
